# ─── Core ──────────────────────────────────────────────────────────────────

# Gemini AI API key (required for Tier-2 intelligence + report generation)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Gemini model to use (default: gemini-2.0-flash)
GEMINI_MODEL="gemini-2.0-flash"

# Server port (default: 3000)
PORT="3000"

# Node environment (development | production)
NODE_ENV="development"

# ─── App URL ───────────────────────────────────────────────────────────────
APP_URL="MY_APP_URL"

# ─── Intelligence Configuration ────────────────────────────────────────────

# IOC cache TTL in ms (default: 1 hour = 3600000)
IOC_CACHE_TTL_MS="3600000"

# Max IOC cache entries (default: 10000)
IOC_CACHE_MAX="10000"

# Human approval timeout in ms before auto-escalation (default: 5 min = 300000)
HUMAN_APPROVAL_TIMEOUT_MS="300000"

# ─── Rate Limiting ──────────────────────────────────────────────────────────

# Rate limit window in ms (default: 60000)
RATE_LIMIT_WINDOW_MS="60000"

# Max requests per window (default: 120)
RATE_LIMIT_MAX="120"

# ─── Logging ───────────────────────────────────────────────────────────────

# Log level: debug | info | warn (default: info)
LOG_LEVEL="info"
